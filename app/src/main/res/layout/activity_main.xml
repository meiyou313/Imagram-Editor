<?xml version="1.0" encoding="utf-8"?>
<!-- Imagram Editor v0.2 — Telegram-style UI (dark, photo fullscreen).
     No text buttons in the editor: tools are icons in a rounded dark
     pill at the bottom, like the Telegram editor the user chose.
     No caption field, no SD/HD, no send button, no stickers:
     those are messaging parts and are deliberately left out. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Editor canvas: fills the whole screen. -->
    <ja.burhanrashid52.photoeditor.PhotoEditorView
        android:id="@+id/photoEditorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Empty state: shown until a photo is picked. -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_image"
            android:tint="#8E8E93" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pick_hint"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPickEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/pick_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:text="@string/pick_photo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Top bar: back / undo / redo / Clear All (draw mode only). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnTopBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnTopUndo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo"
            android:scaleType="center"
            android:src="@drawable/ic_undo"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnTopRedo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/redo"
            android:scaleType="center"
            android:src="@drawable/ic_redo"
            android:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/clear_all"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom: draw panel / adjust panel / main toolbar (one at a time). -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- Draw panel (Telegram draw screen). -->
        <LinearLayout
            android:id="@+id/drawPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Pill: colour wheel + brush-type icons. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageButton
                    android:id="@+id/btnColorWheel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more_colors"
                    android:scaleType="center"
                    android:src="@drawable/ic_color_wheel" />

                <ImageButton
                    android:id="@+id/btnDrawBrush"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/brush"
                    android:scaleType="center"
                    android:src="@drawable/ic_brush"
                    android:tint="@color/tool_icon_tint" />

                <ImageButton
                    android:id="@+id/btnDrawArrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arrow"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_ne"
                    android:tint="@color/tool_icon_tint" />

                <ImageButton
                    android:id="@+id/btnDrawLine"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/line"
                    android:scaleType="center"
                    android:src="@drawable/ic_line"
                    android:tint="@color/tool_icon_tint" />

            </LinearLayout>

            <!-- Colour dots row (filled in code). -->
            <LinearLayout
                android:id="@+id/colorDotsRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- Bottom row: close / DRAW / TEXT / confirm. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDrawClose"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    android:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvDrawTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/draw"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTextTab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/text_tab"
                    android:textColor="#8E8E93"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnDrawDone"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/done"
                    android:scaleType="center"
                    android:src="@drawable/ic_check"
                    android:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- Adjust panel (Telegram adjust screen, real sliders, v0.3).
             Enhance / Exposure / Contrast / Saturation / Sharpness /
             Warmth, driven by GPUImage 2.1.0. CANCEL reverts to the
             values before the panel opened, DONE confirms. -->
        <LinearLayout
            android:id="@+id/adjustPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <!-- Enhance: one-tap AUTO (a tuned combination of GPUImage
                 filters — GPUImage has no single Enhance filter). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/enhance"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnEnhanceAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pick_pill"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp"
                    android:text="@string/enhance_auto"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Exposure slider: -2.0 .. +2.0 (SeekBar 0..100, default 50). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_exposure"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekExposure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#0E7C66"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvExposureValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Contrast slider: 0.0 .. 2.0 (SeekBar 0..100, default 50). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_contrast"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekContrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#0E7C66"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvContrastValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1.00"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Saturation slider: 0.0 .. 2.0 (SeekBar 0..100, default 50). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_saturation"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekSaturation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#0E7C66"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSaturationValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1.00"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Sharpness slider: 0.0 .. 2.0 (SeekBar 0..100, default 0). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_sharpness"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekSharpness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#0E7C66"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSharpnessValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Warmth slider: 4000K .. 7000K (SeekBar 0..100, default 33 = 5000K). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="104dp"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_warmth"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekWarmth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="33"
                    android:progressTint="#0E7C66"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvWarmthValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="5000K"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Bottom row: CANCEL / current filter / DONE. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAdjustCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="@string/cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvAdjustCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adjust_title"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnAdjustDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="@string/done"
                    android:textColor="#0E7C66"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main toolbar: pill (crop / brush / text / adjust) + save. -->
        <LinearLayout
            android:id="@+id/mainBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/pill_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageButton
                    android:id="@+id/btnCrop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/crop"
                    android:scaleType="center"
                    android:src="@drawable/ic_crop"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnBrush"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/brush"
                    android:scaleType="center"
                    android:src="@drawable/ic_brush"
                    android:tint="@color/tool_icon_tint" />

                <ImageButton
                    android:id="@+id/btnText"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/text"
                    android:scaleType="center"
                    android:src="@drawable/ic_text"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnAdjust"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/adjust"
                    android:scaleType="center"
                    android:src="@drawable/ic_tune"
                    android:tint="#FFFFFF" />

            </LinearLayout>

            <!-- Save: teal circle, where Telegram has the blue send button. -->
            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/save_circle"
                android:contentDescription="@string/save"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save"
                android:tint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <!-- Crop screen (v0.3): CropImageView embedded in our own screen.
         The v0.2 bug was the standalone CropImageActivity: its confirm
         control lives in an ActionBar that never appears under our
         NoActionBar theme, so the user was trapped in a crop screen
         with no visible confirm/cancel. Here CANCEL / DONE are our own
         buttons, always visible. Covers the whole screen. -->
    <FrameLayout
        android:id="@+id/cropContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <com.canhub.cropper.CropImageView
            android:id="@+id/cropImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="80dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnCropCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCropDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="@string/done"
                android:textAllCaps="true"
                android:textColor="#0E7C66"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
